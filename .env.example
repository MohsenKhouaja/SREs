GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_SERVICE_TIER=on_demand
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sres-incident-response
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=incident_response
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/incident_db
REDIS_URL=redis://redis:6379
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
SAMPLE_API_URL=http://sample-api:8001
SAMPLE_PAYMENT_URL=http://sample-payment:8002
INVESTIGATION_WARMUP_SECONDS=10
LAB_CONTROLLER_URL=http://127.0.0.1:8010
LAB_MONITOR_TOKEN=replace-with-a-random-monitor-token
LAB_OPERATOR_TOKEN=replace-with-a-different-random-operator-token
VERIFICATION_ROUNDS=3
VERIFICATION_INTERVAL_SECONDS=5
VERIFICATION_TIMEOUT_SECONDS=60
COMPOSE_PROJECT_NAME=sres
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host bindings (container-to-container ports remain standard). The database
# defaults avoid the PostgreSQL and Redis instances already common on dev hosts.
FRONTEND_HOST_PORT=3001
SAMPLE_API_HOST_PORT=8001
SAMPLE_PAYMENT_HOST_PORT=8002
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
MONGODB_HOST_PORT=27017
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
