LLM_PROVIDER=deterministic
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=wayfinder-incident-response
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=incident_response
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/incident_db
REDIS_URL=redis://redis:6379
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
SAMPLE_API_URL=http://sample-api:8001
SAMPLE_PAYMENT_URL=http://sample-payment:8002
SIMULATION_WARMUP_SECONDS=10
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host bindings (container-to-container ports remain standard). The database
# defaults avoid the PostgreSQL and Redis instances already common on dev hosts.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
SAMPLE_API_HOST_PORT=8001
SAMPLE_PAYMENT_HOST_PORT=8002
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
MONGODB_HOST_PORT=27017
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
